From: Experimental SN6140 work <sn6140-rfc@localhost>
Date: Sun, 23 Aug 2026 00:00:00 +0800
Subject: [RFC PATCH] ALSA: hda/conexant: fix Huawei CREF output routing

Huawei MateBook 16s CREF-XX systems with the Conexant SN6140 expose a
non-standard coupling between the headphone pin and the internal speaker.
The speaker on NID 0x17 follows the connection selector on NID 0x16, while
GPIO1 gates the headphone path.  The generic HDA automute implementation
does not know about this coupling, causing speaker/headphone routing to be
reversed or to become silent after a jack transition.

Keep the generic HDA jack and mute handling, then program the coupled
selector, EAPD and GPIO controls from a machine-specific automute hook.
Match only Huawei PCI subsystem 19e5:3e5f, observed with SN6140 codec
subsystem 19e5:327e on CREF-XX/M1010.

This deliberately leaves the SOF machine driver and its DMIC capture PCMs
untouched, so DSP microphone capture remains independent of analog output.

This is an experimental RFC and requires hardware testing before upstream
submission.
---
 sound/hda/codecs/conexant.c | 48 +++++++++++++++++++++++++++++++++++++
 1 file changed, 48 insertions(+)

diff --git a/sound/hda/codecs/conexant.c b/sound/hda/codecs/conexant.c
index e3b6aaabe..311654395 100644
--- a/sound/hda/codecs/conexant.c
+++ b/sound/hda/codecs/conexant.c
@@ -294,6 +294,7 @@ enum {
 	CXT_PINCFG_TOP_SPEAKER,
 	CXT_FIXUP_HP_A_U,
 	CXT_FIXUP_ACER_SWIFT_HP,
+	CXT_FIXUP_HUAWEI_CREF,
 };
 
 /* for hda_fixup_thinkpad_acpi() */
@@ -797,6 +798,47 @@ static void cxt_fixup_hp_a_u(struct hda_codec *codec,
 		cxt_setup_gpio_unmute(codec, 0x2);
 }
 
+/*
+ * Huawei MateBook 16s (CREF-XX) wires the SN6140 output pins in an
+ * unusual way: the speaker on NID 0x17 follows the connection selector
+ * of the headphone pin (0x16). GPIO1 additionally gates the headphone
+ * path. Keep the generic HDA jack and mute state handling, then program
+ * the coupled routing controls to match the detected output.
+ */
+static void cxt_huawei_cref_update_outputs(struct hda_codec *codec)
+{
+	struct conexant_spec *spec = codec->spec;
+	bool hp_present = spec->gen.hp_jack_present;
+	bool speaker_on = !hp_present && !spec->gen.master_mute;
+
+	snd_hda_gen_update_outputs(codec);
+
+	/* NID 0x17 follows this selector despite having its own selector. */
+	snd_hda_codec_write_cache(codec, 0x16, 0,
+				  AC_VERB_SET_CONNECT_SEL, hp_present ? 0 : 1);
+
+	/* The speaker and headphone paths share an external power gate. */
+	snd_hda_codec_write(codec, 0x17, 0,
+			    AC_VERB_SET_EAPD_BTLENABLE, speaker_on ? 0x02 : 0);
+	snd_hda_codec_set_gpio(codec, 0x02, 0x02, hp_present ? 0 : 0x02, 0);
+}
+
+static void cxt_fixup_huawei_cref(struct hda_codec *codec,
+				  const struct hda_fixup *fix, int action)
+{
+	struct conexant_spec *spec = codec->spec;
+
+	switch (action) {
+	case HDA_FIXUP_ACT_PROBE:
+		WARN_ON(spec->gen.automute_hook);
+		spec->gen.automute_hook = cxt_huawei_cref_update_outputs;
+		break;
+	case HDA_FIXUP_ACT_INIT:
+		cxt_huawei_cref_update_outputs(codec);
+		break;
+	}
+}
+
 /* ThinkPad X200 & co with cxt5051 */
 static const struct hda_pintbl cxt_pincfg_lenovo_x200[] = {
 	{ 0x16, 0x042140ff }, /* HP (seq# overridden) */
@@ -1025,6 +1067,10 @@ static const struct hda_fixup cxt_fixups[] = {
 			{ }
 		},
 	},
+	[CXT_FIXUP_HUAWEI_CREF] = {
+		.type = HDA_FIXUP_FUNC,
+		.v.func = cxt_fixup_huawei_cref,
+	},
 };
 
 static const struct hda_quirk cxt5045_fixups[] = {
@@ -1124,6 +1170,7 @@ static const struct hda_quirk cxt5066_fixups[] = {
 	SND_PCI_QUIRK(0x17aa, 0x3978, "Lenovo G50-70", CXT_FIXUP_STEREO_DMIC),
 	SND_PCI_QUIRK(0x17aa, 0x397b, "Lenovo S205", CXT_FIXUP_STEREO_DMIC),
 	SND_PCI_QUIRK_VENDOR(0x17aa, "Thinkpad/Ideapad", CXT_FIXUP_LENOVO_XPAD_ACPI),
+	SND_PCI_QUIRK(0x19e5, 0x3e5f, "Huawei MateBook 16s CREF-XX", CXT_FIXUP_HUAWEI_CREF),
 	SND_PCI_QUIRK(0x1c06, 0x2011, "Lemote A1004", CXT_PINCFG_LEMOTE_A1004),
 	SND_PCI_QUIRK(0x1c06, 0x2012, "Lemote A1205", CXT_PINCFG_LEMOTE_A1205),
 	SND_PCI_QUIRK(0x1d05, 0x3012, "MECHREVO Wujie 15X Pro", CXT_FIXUP_HEADSET_MIC),
@@ -1151,6 +1198,7 @@ static const struct hda_model_fixup cxt5066_fixup_models[] = {
 	{ .id = CXT_PINCFG_SWS_JS201D, .name = "sws-js201d" },
 	{ .id = CXT_PINCFG_TOP_SPEAKER, .name = "sirius-top-speaker" },
 	{ .id = CXT_FIXUP_HP_A_U, .name = "HP-U-support" },
+	{ .id = CXT_FIXUP_HUAWEI_CREF, .name = "huawei-cref-sn6140" },
 	{}
 };
 
